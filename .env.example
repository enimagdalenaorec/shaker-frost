# Copy to .env.local and fill in. .env.local is git-ignored. Never commit real values.

# Google AI Studio  (aistudio.google.com -> Get API key)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional backup provider: used only if every Gemini model fails (quota / overload)
OPENAI_API_KEY=
# OPENAI_MODEL_STRONG=
# OPENAI_MODEL_FAST=
# The same key draws the dish illustrations in the background (no key = no pictures). Defaults in lib/ai/models.ts
# OPENAI_IMAGE_MODEL=
# OPENAI_IMAGE_QUALITY=low
# Optional overrides; defaults live in lib/ai/models.ts
# LLM_MODEL_FAST=
# LLM_MODEL_STRONG=

# Supabase  (Project Settings -> API Keys, and the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# App
DEMO_PASSWORD=
ENABLE_WEB_FALLBACK=true
