# Copy to .env.local and fill in. .env.local is git-ignored. Never commit real values.

# Google AI Studio  (aistudio.google.com -> Get API key)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional overrides; defaults live in lib/ai/models.ts
# LLM_MODEL_FAST=
# LLM_MODEL_STRONG=

# Supabase  (Project Settings -> API Keys, and the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# App
DEMO_PASSWORD=
ENABLE_WEB_FALLBACK=true
